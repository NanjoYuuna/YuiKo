{
  "name": "yuiko",
  "version": "1.0.0",
  "description": "YuiKo (小魚子) — TRPG & Social Entertainment Discord Bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy-commands": "ts-node-dev --transpile-only src/interactions/deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "trpg",
    "dice"
  ],
  "author": "YuiKo",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/sharp": "^0.31.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
